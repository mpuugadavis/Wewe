APP_ENV=development
LOG_LEVEL=INFO
API_PREFIX=/api/v1
DATABASE_URL=postgresql+psycopg://wewe:replace-me@postgres:5432/wewe
SECRET_KEY=replace-with-at-least-32-random-bytes-before-running
ACCESS_TOKEN_MINUTES=15
REFRESH_TOKEN_DAYS=30
PASSWORD_RESET_MINUTES=30
CORS_ORIGINS=http://localhost:5500,http://127.0.0.1:5500,http://localhost:5173
PAYMENT_MODE=DISABLED
PAYMENT_PROVIDER=PAWAPAY
PAWAPAY_API_TOKEN=
PAWAPAY_API_BASE_URL=https://api.sandbox.pawapay.io
PAWAPAY_ENVIRONMENT=SANDBOX
PAWAPAY_CHECKOUT_CALLBACK_URL=http://localhost:8000/api/v1/payments/pawapay/checkout-callback
PAWAPAY_DEPOSIT_CALLBACK_URL=http://localhost:8000/api/v1/payments/pawapay/deposit-callback
PAWAPAY_PAYOUT_CALLBACK_URL=http://localhost:8000/api/v1/payments/pawapay/payout-callback
PAWAPAY_REFUND_CALLBACK_URL=http://localhost:8000/api/v1/payments/pawapay/refund-callback
# Flutterwave v4 OAuth. Set PAYMENT_MODE=EXTERNAL only with sandbox Client ID/Client Secret.
FLUTTERWAVE_ENVIRONMENT=SANDBOX
FLUTTERWAVE_CLIENT_ID=
FLUTTERWAVE_CLIENT_SECRET=
# Optional until Webhooks is enabled on the Flutterwave dashboard.
FLUTTERWAVE_WEBHOOK_SECRET_HASH=
FLUTTERWAVE_REDIRECT_URL=http://localhost:5500/
FLUTTERWAVE_API_BASE_URL=https://developersandbox-api.flutterwave.com
# Use memory:// for a single local process. Production must use shared Redis.
RATE_LIMIT_STORAGE_URI=memory://
PAYMENT_WEBHOOK_SECRET=replace-before-enabling-payment-webhooks
PAYMENT_CALLBACK_URL=https://api.example.invalid/api/v1/payments/webhooks
# Road-route distance for delivery pricing (COM-FEE-004).
# OSRM is the safe local-development default and uses real road routes without a Google billing setup.
# OpenRouteService provides hosted road routing without a billing card for the free Standard plan.
ROUTING_PROVIDER=OPENROUTESERVICE
OPENROUTESERVICE_API_KEY=
GOOGLE_MAPS_API_KEY=
# Browser-restricted key for Maps JavaScript + Places in frontend (HTTP referrer restricted).
GOOGLE_MAPS_BROWSER_API_KEY=
ROUTING_BASE_URL=
ROUTING_TIMEOUT_SECONDS=5
ROUTING_USER_AGENT=WEWE-campus-delivery/1.0
POSTGRES_DB=wewe
POSTGRES_USER=wewe
POSTGRES_PASSWORD=replace-with-a-unique-development-password
WEWE_SEED_PASSWORD=replace-with-a-unique-12-character-development-password
EMAIL_FROM=no-reply@example.invalid
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMS_PROVIDER=
SMS_API_URL=
SMS_API_KEY=
MTN_MOMO_API_KEY=
MTN_MOMO_API_SECRET=
AIRTEL_MONEY_API_KEY=
AIRTEL_MONEY_API_SECRET=
MEDIA_ALLOWED_HOSTS=
MEDIA_MAX_UPLOAD_BYTES=5242880
# Object storage is S3-compatible. Local Docker uses MinIO; production uses Cloudflare R2.
# For Cloudflare R2:
#   STORAGE_PROVIDER=S3
#   STORAGE_BUCKET=wewe
#   STORAGE_ENDPOINT=https://<CLOUDFLARE_ACCOUNT_ID>.r2.cloudflarestorage.com
#   STORAGE_PUBLIC_BASE_URL=https://media.example.com
#   STORAGE_ACCESS_KEY=<R2_ACCESS_KEY_ID>
#   STORAGE_SECRET_KEY=<R2_SECRET_ACCESS_KEY>
#
# STORAGE_PUBLIC_BASE_URL must be the public R2 custom domain in production so
# product images are delivered through Cloudflare's edge cache rather than the API.
STORAGE_PROVIDER=S3
STORAGE_BUCKET=wewe
STORAGE_ENDPOINT=http://minio:9000
STORAGE_PUBLIC_BASE_URL=http://localhost:9000/wewe-media
STORAGE_ACCESS_KEY=wewe-local
STORAGE_SECRET_KEY=wewe-local-storage-password

MEDIA_CLEANUP_POLL_SECONDS=300
MEDIA_CLEANUP_DRY_RUN=true
MEDIA_CLEANUP_PREFIX=products/
WORKER_HEALTH_STALE_AFTER_SECONDS=900
BACKUP_MAX_AGE_SECONDS=86400
