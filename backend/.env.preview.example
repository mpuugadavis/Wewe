# WEWE sandbox preview template
# Copy into the deployment secret store; NEVER commit real values.

APP_ENV=staging
LOG_LEVEL=INFO
API_PREFIX=/api/v1

# Managed PostgreSQL
DATABASE_URL=postgresql+psycopg://wewe:URL_ENCODED_POSTGRES_PASSWORD@postgres:5432/wewe_preview
POSTGRES_DB=wewe
POSTGRES_USER=wewe
POSTGRES_PASSWORD=DO_NOT_STORE_IN_REPO

# Authentication / security
SECRET_KEY=GENERATE_A_UNIQUE_RANDOM_SECRET_AT_LEAST_32_CHARACTERS
ACCESS_TOKEN_MINUTES=15
REFRESH_TOKEN_DAYS=30
PASSWORD_RESET_MINUTES=30
TRUSTED_HOSTS=preview.example.com,localhost,127.0.0.1
CORS_ORIGINS=https://preview.example.com

# Sandbox payments only — PawaPay
# Use sandbox credentials and public HTTPS callbacks.
PAYMENT_MODE=EXTERNAL
PAYMENT_PROVIDER=PAWAPAY
PAWAPAY_ENVIRONMENT=SANDBOX
PAWAPAY_API_TOKEN=
PAWAPAY_API_BASE_URL=https://api.sandbox.pawapay.io
PAWAPAY_VERIFY_CALLBACKS=true
PAWAPAY_CHECKOUT_CALLBACK_URL=https://preview.example.com/api/v1/payments/pawapay/checkout-callback
PAWAPAY_DEPOSIT_CALLBACK_URL=https://preview.example.com/api/v1/payments/pawapay/deposit-callback
PAWAPAY_PAYOUT_CALLBACK_URL=https://preview.example.com/api/v1/payments/pawapay/payout-callback
PAWAPAY_REFUND_CALLBACK_URL=https://preview.example.com/api/v1/payments/pawapay/refund-callback
PAYMENT_WEBHOOK_SECRET=GENERATE_A_UNIQUE_RANDOM_SECRET_AT_LEAST_32_CHARACTERS

# Shared rate-limit store
RATE_LIMIT_STORAGE_URI=redis://redis:6379/0

# Real road routing for server-authoritative delivery pricing
ROUTING_PROVIDER=OPENROUTESERVICE
OPENROUTESERVICE_API_KEY=
ROUTING_BASE_URL=
ROUTING_TIMEOUT_SECONDS=12
ROUTING_USER_AGENT=WEWE-campus-delivery/1.0

# Production object storage (S3-compatible; not local MinIO)
STORAGE_PROVIDER=S3
STORAGE_BUCKET=
STORAGE_ENDPOINT=
STORAGE_PUBLIC_BASE_URL=
STORAGE_ACCESS_KEY=
STORAGE_SECRET_KEY=
MEDIA_ALLOWED_HOSTS=
MEDIA_MAX_UPLOAD_BYTES=5242880
MEDIA_SIGNED_URL_TTL_SECONDS=300
MEDIA_CLEANUP_GRACE_SECONDS=86400
MEDIA_CLEANUP_POLL_SECONDS=300
MEDIA_CLEANUP_DRY_RUN=true
MEDIA_CLEANUP_PREFIX=products/

# Workers / operations
WORKER_HEALTH_STALE_AFTER_SECONDS=900
BACKUP_MAX_AGE_SECONDS=86400
NOTIFICATION_WORKER_BATCH_SIZE=50
NOTIFICATION_WORKER_POLL_SECONDS=2
NOTIFICATION_WORKER_STALE_AFTER_SECONDS=300
NOTIFICATION_WORKER_MAX_ATTEMPTS=8

# Account recovery email
EMAIL_FROM=no-reply@example.com
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=

# Unused legacy/provider slots — leave unset unless an explicit adapter is enabled.
SMS_PROVIDER=
SMS_API_URL=
SMS_API_KEY=
MTN_MOMO_API_KEY=
MTN_MOMO_API_SECRET=
AIRTEL_MONEY_API_KEY=
AIRTEL_MONEY_API_SECRET=

WEWE_DOMAIN=preview.example.com
MAX_REQUEST_BODY_BYTES=6291456
